{
  "name": "paycore",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @paycore/api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w @paycore/api && npm run build -w web",
    "db:migrate": "npm run db:migrate -w @paycore/api",
    "test": "npm run test -w @paycore/api && npm run test -w web",
    "test:integration": "npm run test:integration -w @paycore/api",
    "typecheck": "npm run typecheck -w @paycore/api && npm run typecheck -w web",
    "lint": "eslint . && npm run lint -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
