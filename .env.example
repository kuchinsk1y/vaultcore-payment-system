DATABASE_URL="postgres://paycore:password@localhost:5432/paycore"
PORT=3000

# Security
JWT_SECRET=change-me
API_KEY=change-me                 # required for /metrics
HOST=127.0.0.1                    # use 0.0.0.0 only inside a container
CORS_ORIGINS=http://localhost:3000

# Integration tests wipe tables: they use a dedicated database (name must end with _test)
TEST_DATABASE_URL=postgres://paycore:password@localhost:5432/paycore_test

# Account security
ENCRYPTION_KEY=                   # 64 hex chars (32 bytes); encrypts TOTP secrets. Required in production:
                                  #   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_URL=http://localhost:3000     # used to build links in emails
ACCESS_TOKEN_TTL_SECONDS=900      # 15 min access token
REFRESH_TOKEN_TTL_SECONDS=2592000 # 30 day session (sliding)
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
LARGE_TRANSFER_THRESHOLD=100000   # minor units; transfers at/above need a one-time code (0 = off)

# Demo top-ups ("Add funds" on the dashboard). On by default outside production; off in production unless set.
ENABLE_DEMO_TOPUP=true
